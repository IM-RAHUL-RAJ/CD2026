# PostgreSQL configuration
DB_NAME=trading_system_db
DB_USER=postgres
DB_PASSWORD=replace_with_strong_password

# JWT Secret - must be at least 32 characters.
# Used by trade-api to verify tokens issued by the Sprint 8 auth service.
JWT_SECRET=replace_with_at_least_32_character_secret_key

# Issuer the auth service signs tokens with (must match the auth service).
JWT_ISSUER=auth-service

KAFKA_BOOTSTRAP_SERVERS=10.8.71.240:9092