# PostgreSQL configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=trading_db
DB_USER=postgres
DB_PASSWORD=replace_with_strong_password

# Kafka configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Auth & Security
JWT_SECRET=replace_with_at_least_32_character_secret_key

# Fauxnance API & Poller
FAUXNANCE_API_KEY=replace_with_fauxnance_api_key
POLL_INTERVAL_SECONDS=60
