# Sprint 8 Auth Service environment
# Copy to .env and adjust for your machine.

# HTTP
PORT=3000

# Database (PostgreSQL, shared trading_system_db with auth + trading schemas)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=n3u3d4!
DB_NAME=trading_system_db

# JWT
JWT_SECRET=akatsuki_akatsuki_akatsuki_akatsuki_akatsuki
JWT_ISSUER=auth-service
JWT_TTL_SECONDS=900

# Refresh token lifetime (seconds). Default 7 days.
REFRESH_TTL_SECONDS=604800

# Login throttling
THROTTLE_MAX_ATTEMPTS=5
THROTTLE_WINDOW_MS=900000

# Refresh-token cookie (HttpOnly + SameSite always on; Secure controlled below)
# Secure is honoured by browsers even over http://localhost (trusted origin);
# set COOKIE_SECURE=false only for plain-HTTP demos on non-local hosts.
# COOKIE_SAMESITE: lax (recommended) | strict | none
COOKIE_NAME=refresh_token
COOKIE_SECURE=true
COOKIE_SAMESITE=lax