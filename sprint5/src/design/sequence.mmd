sequenceDiagram
    autonumber

    actor Client
    participant TS as TradeSystem
    participant AM as AccountManager
    participant I as Instrument
    participant OVS as OrderValidationService
    participant H as Holdings
    participant OE as OrderExecutor
    participant A as Account
    participant P as Position


    Client->>TS: placeOrder(orderId, PlaceOrderRequest)


    %% Account validation
    TS->>AM: Validate account(accountId)

    alt Account not found
        AM-->>TS: AccountNotFoundException
        TS-->>Client: Order rejected
    else Account found
        AM->>AM: Check account status

        alt Account not ACTIVE
            AM-->>TS: AccountNotActiveException
            TS-->>Client: Order rejected
        else Account ACTIVE
            AM-->>TS: Return Account
        end
    end


    %% Instrument lookup
    TS->>I: Find instrument(symbol)

    alt Instrument does not exist
        I-->>TS: InstrumentNotFoundException
        TS-->>Client: Order rejected
    else Instrument found
        I-->>TS: Return Instrument
    end


    %% Order creation
    TS->>TS: Create Order\n(status = NEW)


    %% Order validation
    TS->>OVS: Validate Order


    OVS->>OVS: Check idempotency key

    alt Duplicate idempotency key
        OVS-->>TS: DuplicateOrderException
        TS-->>Client: Order rejected
    end


    OVS->>OVS: Validate instrument tradeability

    alt Instrument unavailable/not tradeable
        OVS-->>TS: InstrumentNotFoundException
        TS-->>Client: Order rejected
    end


    alt Order side = BUY

        OVS->>I: Check available quantity

        alt Insufficient instrument quantity
            I-->>OVS: InsufficientInstrumentQuantityException
            OVS-->>TS: Validation failed
            TS-->>Client: Order rejected
        else Quantity available
            OVS-->>TS: BUY order valid
        end


    else Order side = SELL

        OVS-->>TS: SELL order valid\n(holdings checked later)

    end



    %% Holdings
    TS->>H: Find holdings(accountId, instrumentId)

    alt Holdings does not exist
        TS->>H: Create empty Holdings
    else Holdings exists
        H-->>TS: Existing Holdings
    end



    %% Execution
    TS->>OE: Execute order


    alt Order side = BUY

        OE->>A: Check account balance

        alt Insufficient funds
            A-->>OE: Cannot afford order
            OE-->>TS: InsufficientFundsException
            TS-->>Client: Order rejected
        else Sufficient funds

            OE->>A: Debit order amount
            OE->>I: Reserve quantity
            OE->>H: Add purchased quantity
            H->>H: Recalculate weighted average price

        end



    else Order side = SELL

        OE->>H: Check holdings quantity

        alt Insufficient holdings
            H-->>OE: Cannot sell quantity
            OE-->>TS: InsufficientHoldingsException
            TS-->>Client: Order rejected

        else Holdings available

            OE->>H: Remove sold quantity
            OE->>A: Credit order amount

        end

    end



    %% Completion
    TS->>TS: Mark order FILLED

    TS->>P: Create Position(orderId)

    TS->>TS: Store holdings and position

    TS->>OVS: Accept idempotency key


    TS-->>Client: Order Filled
