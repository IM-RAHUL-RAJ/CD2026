# Enterprise Trading Platform: Manifest Configuration
# Defines package names, module paths, function names, entry points, and test specifications.

PROJECT_NAME=leap-capstone-eda
PACKAGE_NAME=src

# Extraction Module
EXTRACT_MODULE=src.extract.extract
EXTRACT_FUNCTION=extract_data
SAVE_EXTRACTED_FUNCTION=save_extracted_data
CANDLES_TO_DF_FUNCTION=candles_to_dataframe

# Transformation Module
TRANSFORM_MODULE=src.transform.transform
TRANSFORM_FUNCTION=transform
TRANSFORM_FILE_FUNCTION=transform_file
VALIDATE_SCHEMA_FUNCTION=validate_schema
VALIDATE_DATA_FUNCTION=validate_data

# Load Module
LOAD_MODULE=src.load.load
LOAD_CLASS=TradingLoader

# EDA Module
EDA_MODULE=src.eda.generate_dashboard
EDA_FUNCTION=create_dashboard
LOAD_DATA_FUNCTION=load_data
CALCULATE_METRICS_FUNCTION=calculate_metrics

# Pipeline Core
PIPELINE_MODULE=src.pipeline.pipeline
PIPELINE_FUNCTION=run_pipeline
START_ETL_FUNCTION=start_etl

# Web API Module
API_MODULE=src.api.app
API_CLIENT_MODULE=src.api.apiClient
API_CLIENT_CLASS=FauxnanceClient

# Entry Point Commands
ENTRY_POINT_PIPELINE=python -m src.pipeline.pipeline
ENTRY_POINT_SERVER=python -m src.api.app
ENTRY_POINT_CLI_PIPELINE=fauxnance-pipeline
ENTRY_POINT_CLI_SERVE=fauxnance-serve
ENTRY_POINT_CLI_EXTRACT=fauxnance-extract

# Test Suite Specifications
TEST_RUNNER=pytest
TEST_API_CLIENT=tests/test_api_client.py
TEST_TRANSFORM=tests/test_transform.py
TEST_PIPELINE=tests/test_pipeline.py
TEST_NAME=pytest
